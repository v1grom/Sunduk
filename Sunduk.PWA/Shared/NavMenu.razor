@inject NavigationManager Navigation
<MudNavMenu>
    @foreach (var root in NavCatalog.Roots)
    {
        var children = NavCatalog.ChildrenOf(root.Href);
        if (children.Count == 0)
        {
            <MudNavLink Href="@root.Href" Match="NavLinkMatch.Prefix" Icon="@root.Icon">@root.Title</MudNavLink>
        }
        else
        {
            @* Раздел с вкладками: сам раздел открывает первую вкладку, группа раскрыта, когда в ней находится пользователь *@
            <MudNavGroup Title="@root.Title" Icon="@root.Icon" Expanded="@IsInside(root)">
                @foreach (var child in children)
                {
                    <MudNavLink Href="@child.Href" Match="NavLinkMatch.All" Icon="@child.Icon">@child.Title</MudNavLink>
                }
            </MudNavGroup>
        }
    }
</MudNavMenu>

@code {
    [CascadingParameter(Name = "ExperimantalMode")]
    protected bool ExperimantalMode { get; set; }

    private bool IsInside(NavSection root) =>
        NavCatalog.Find(Navigation.ToBaseRelativePath(Navigation.Uri)) is { } current
        && (current.Href == root.Href || current.ParentHref == root.Href);
}
