@page "/milling"
@page "/milling/{Tab}"

<SectionTabs Section="@NavCatalog.Milling" Tab="@Tab">
    <Content Context="key">
        @if (key == "chamfer")
        {
            <MillingChamferComponent />
        }
        else
        {
            <MillingComponent Part="@key" />
        }
    </Content>
</SectionTabs>

@code
{
    [Parameter] public string? Tab { get; set; }
}
