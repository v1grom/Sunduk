@page "/material"
@page "/material/{Tab}"

<SectionTabs Section="@NavCatalog.Material" Tab="@Tab">
    <Content Context="key">
        @switch (key)
        {
            case "tolerance": <ToleranceComponent /> break;
            case "hardness": <HardnessConverterComponent /> break;
            case "ra-rz": <RoughnessConverterComponent /> break;
        }
    </Content>
</SectionTabs>

@code
{
    [Parameter] public string? Tab { get; set; }
}
