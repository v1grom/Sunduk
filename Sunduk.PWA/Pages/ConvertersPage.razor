@page "/converters"

<ChipTabs Titles="titles">
    <Content Context="i">
        @switch (i)
        {
            case 0: <AngleConverterComponent /> break;
            case 1: <PointCoordinatesComponent /> break;
            case 2: <RoughnessConverterComponent /> break;
            case 3: <HardnessConverterComponent /> break;
        }
    </Content>
</ChipTabs>

@code
{
    static readonly string[] titles = ["Углы", "Координаты точки", "Ra ↔ Rz", "Твёрдость"];
}
