@page "/stuff"
@page "/converters"
@page "/material"
@page "/material/{Tab}"
@page "/geometry/chamfer"
@page "/geometry/arcs"
@page "/knowledge/custom-victor-cycles"
@inject NavigationManager Navigation
@* Старые адреса разделов (закладки, установленные PWA) ведут в новые места по NavCatalog.Moved *@

@code
{
    [Parameter] public string? Tab { get; set; }

    protected override void OnInitialized()
    {
        var path = new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/').ToLowerInvariant();
        var target = NavCatalog.Migrate(path);
        Navigation.NavigateTo(target == path ? "/" : target, replace: true);
    }
}
