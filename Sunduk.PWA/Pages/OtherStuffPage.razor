@page "/stuff"

<ChipTabs Titles="titles">
    <Content Context="i">
        @switch (i)
        {
            case 0: <ThreadTurningComponent /> break;
            case 1: <ChamferComponent /> break;
            case 2: <ArcsComponent /> break;
            case 3: <DrillAngleComponent /> break;
            case 4: <HoleCapacityComponent /> break;
            case 5: <RoughnessComponent /> break;
            case 6: <MillingComponent /> break;
        }
    </Content>
</ChipTabs>

@code
{
    static readonly string[] titles =
        ["Резьба", "Фаска", "Дуги", "Конус сверла", "Расточка", "Шероховатость", "Фрезерование"];
}
