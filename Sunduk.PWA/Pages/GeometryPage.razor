@page "/geometry"
@page "/geometry/{Tab}"

<SectionTabs Section="@NavCatalog.Geometry" Tab="@Tab">
    <Content Context="key">
        @switch (key)
        {
            case "drill-angle": <DrillAngleComponent /> break;
            case "point": <PointCoordinatesComponent /> break;
            case "angles": <AngleConverterComponent /> break;
        }
    </Content>
</SectionTabs>

@code
{
    [Parameter] public string? Tab { get; set; }
}
