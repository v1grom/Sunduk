@page "/knowledge"
@page "/knowledge/{Tab}"

<SectionTabs Section="@NavCatalog.Knowledge" Tab="@Tab">
    <Content Context="key">
        @switch (key)
        {
            @* Расчётные компоненты задают отступы сами, статьям-таблицам их даёт обёртка *@
            case "hardness": <HardnessConverterComponent /> break;
            case "ra-rz": <RoughnessConverterComponent /> break;
            case "vectors": <VectorComponent /> break;
            default:
                <div class="pa-3">
                    @switch (key)
                    {
                        case "bspp-thread": <BsppThreadComponent /> break;
                        case "npt-thread": <NptThreadComponent /> break;
                        case "center-length": <CenterLengthComponent /> break;
                        case "formulas": <FormulasComponent /> break;
                        case "macro-b": <FanucMacroVariables /> break;
                    }
                </div>
                break;
        }
    </Content>
</SectionTabs>

@code
{
    [Parameter] public string? Tab { get; set; }
}
