    <path class="sk-part" d="M10,115 L96.4,115 A70,70 0 0 0 203.6,115 L290,115 L290,186 L10,186 Z" />
    <path class="sk-line @(Active == "diameter" ? "active" : null)" d="M80,6 L80,70 A70,70 0 0 0 220,70 L220,6" />
    <line class="sk-axis" x1="150" y1="2" x2="150" y2="160" />

    <SketchDim X1="80" Y1="30" X2="220" Y2="30" Label="D" LabelX="118" LabelY="24" Active="@(Active == "diameter")" />

    <path class="sk-thin" d="M96.4,115 L96.4,92 M203.6,115 L203.6,92" />
    <SketchDim X1="96.4" Y1="98" X2="203.6" Y2="98" Label="Dэф" LabelX="178" LabelY="92" />

    <path class="sk-thin" d="M150,140 L250,140" />
    <SketchDim X1="244" Y1="115" X2="244" Y2="140" Label="ap" LabelX="252" LabelY="131" Anchor="start" Active="@(Active == "depth")" />
</Sketch>

@code
{
    /// <summary> Подсвечиваемый размер: diameter или depth. </summary>
    [Parameter] public string? Active { get; set; }
}
