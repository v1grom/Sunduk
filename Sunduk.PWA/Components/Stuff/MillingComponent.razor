@inject RoughnessState State
<MudGrid Spacing="1" Class="pa-2">
    @if (Part == "chip-thinning")
    {
    <MudItem xs="12" sm="6">
        <MudField Label="Параметры" Variant="Variant.Filled" Underline="false" Class="mt-1">
            <MudTextField Class="monofield" Variant="Variant.Text" @bind-Value="State.ThinningDiameter" T="string" Label="Диаметр фрезы" @onfocus="@(() => _active = "diameter")"
                          InputMode="@(InputMode.@decimal)" Adornment="Adornment.End" AdornmentText="мм" Immediate="true" Margin="Margin.Dense" />
            <MudTextField Class="monofield" Variant="Variant.Text" @bind-Value="State.ThinningWidth" T="string" Label="Ширина резания ae" @onfocus="@(() => _active = "width")"
                          InputMode="@(InputMode.@decimal)" Adornment="Adornment.End" AdornmentText="мм" Immediate="true" Margin="Margin.Dense" />
            <MudTextField Class="monofield" Variant="Variant.Text" @bind-Value="State.ThinningFeed" T="string" Label="Паспортная подача" @onfocus="@(() => _active = "feed")"
                          InputMode="@(InputMode.@decimal)" Adornment="Adornment.End" AdornmentText="мм/зуб" Immediate="true" Margin="Margin.Dense" />
        </MudField>
    </MudItem>
    <MudItem xs="12" sm="6">
        <ChipThinningSketch Active="@_active" />
    </MudItem>
    <MudItem xs="12">
        <MudField Label="Результат" Variant="Variant.Filled" Underline="false">
            <MudText Typo="Typo.body2">@ThinningResult</MudText>
        </MudField>
    </MudItem>
    <MudItem xs="12">
        <CalcNote>
            При ширине резания меньше половины диаметра стружка тоньше подачи на зуб: hmax = fz·2·√(ae·(D − ae))/D. Чтобы зуб резал, а не тёр, подачу поднимают до паспортной толщины стружки.
        </CalcNote>
    </MudItem>
    }
    @if (Part == "high-feed")
    {
    <MudItem xs="12" sm="6">
        <MudField Label="Параметры" Variant="Variant.Filled" Underline="false" Class="mt-1">
            <MudTextField Class="monofield" Variant="Variant.Text" @bind-Value="State.HighFeedDiameter" T="string" Label="Диаметр фрезы"
                          InputMode="@(InputMode.@decimal)" Adornment="Adornment.End" AdornmentText="мм" Immediate="true" Margin="Margin.Dense" />
            <MudTextField Class="monofield" Variant="Variant.Text" @bind-Value="State.HighFeedWidth" T="string" Label="Ширина резания ae"
                          InputMode="@(InputMode.@decimal)" Adornment="Adornment.End" AdornmentText="мм" Immediate="true" Margin="Margin.Dense" />
            <MudTextField Class="monofield" Variant="Variant.Text" @bind-Value="State.HighFeedAngle" T="string" Label="Угол в плане κ" @onfocus="@(() => _active = "angle")"
                          InputMode="@(InputMode.@decimal)" Adornment="Adornment.End" AdornmentText="°" Immediate="true" Margin="Margin.Dense" />
            <MudTextField Class="monofield" Variant="Variant.Text" @bind-Value="State.HighFeedFz" T="string" Label="Паспортная подача" @onfocus="@(() => _active = "feed")"
                          InputMode="@(InputMode.@decimal)" Adornment="Adornment.End" AdornmentText="мм/зуб" Immediate="true" Margin="Margin.Dense" />
            <MudTextField Class="monofield" Variant="Variant.Text" @bind-Value="State.HighFeedTeeth" T="string" Label="Число зубьев"
                          InputMode="@(InputMode.@numeric)" Immediate="true" Margin="Margin.Dense" />
            <MudTextField Class="monofield" Variant="Variant.Text" @bind-Value="State.HighFeedSpeed" T="string" Label="Обороты"
                          InputMode="@(InputMode.@decimal)" Adornment="Adornment.End" AdornmentText="об/мин" Immediate="true" Margin="Margin.Dense" />
        </MudField>
    </MudItem>
    <MudItem xs="12" sm="6">
        <HighFeedSketch Active="@_active" />
    </MudItem>
    <MudItem xs="12">
        <MudField Label="Результат" Variant="Variant.Filled" Underline="false">
            <MudText Typo="Typo.body2" Style="white-space: pre-line;">@HighFeedResult</MudText>
        </MudField>
    </MudItem>
    <MudItem xs="12">
        <CalcNote>
            У фрез с малым углом в плане стружка тоньше подачи на зуб: hmax = fz·sin κ (при 15° — около 26%), поэтому паспортные подачи большие. Паспортная подача уже учитывает угол, при малой ae её поднимают ещё и на радиальное утонение. Для круглых пластин угол в плане меняется с глубиной — там сверяйтесь с каталогом.
        </CalcNote>
    </MudItem>
    }
    @if (Part == "ball")
    {
    <MudItem xs="12" sm="6">
        <MudField Label="Эффективный диаметр" Variant="Variant.Filled" Underline="false" Class="mt-1">
            <MudTextField Class="monofield" Variant="Variant.Text" @bind-Value="State.BallDiameter" T="string" Label="Диаметр фрезы" @onfocus="@(() => _active = "diameter")"
                          InputMode="@(InputMode.@decimal)" Adornment="Adornment.End" AdornmentText="мм" Immediate="true" Margin="Margin.Dense" />
            <MudTextField Class="monofield" Variant="Variant.Text" @bind-Value="State.BallDepth" T="string" Label="Глубина резания ap" @onfocus="@(() => _active = "depth")"
                          InputMode="@(InputMode.@decimal)" Adornment="Adornment.End" AdornmentText="мм" Immediate="true" Margin="Margin.Dense" />
            <MudTextField Class="monofield" Variant="Variant.Text" @bind-Value="State.BallSpeed" T="string" Label="Скорость резания" @onfocus="@(() => _active = null)"
                          InputMode="@(InputMode.@decimal)" Adornment="Adornment.End" AdornmentText="м/мин" Immediate="true" Margin="Margin.Dense" />
        </MudField>
    </MudItem>
    <MudItem xs="12" sm="6">
        <BallSketch Active="@_active" />
    </MudItem>
    <MudItem xs="12">
        <MudField Label="Результат" Variant="Variant.Filled" Underline="false">
            <MudText Typo="Typo.body2">@BallResult</MudText>
        </MudField>
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudField Label="Гребешок" Variant="Variant.Filled" Underline="false" Class="mt-1">
            <MudTextField Class="monofield" Variant="Variant.Text" @bind-Value="ScallopDiameter" T="string" Label="Диаметр фрезы" @onfocus="@(() => _active = "s-diameter")"
                          InputMode="@(InputMode.@decimal)" Adornment="Adornment.End" AdornmentText="мм" Immediate="true" Margin="Margin.Dense" />
            <MudTextField Class="monofield" Variant="Variant.Text" Value="State.ScallopStep" ValueChanged="@((string v) => SetScallop(false, v))" T="string" Label="Шаг между проходами" @onfocus="@(() => _active = "step")"
                          InputMode="@(InputMode.@decimal)" Adornment="Adornment.End" AdornmentText="мм" Immediate="true" Margin="Margin.Dense" />
            <MudTextField Class="monofield" Variant="Variant.Text" Value="State.ScallopHeight" ValueChanged="@((string v) => SetScallop(true, v))" T="string" Label="Высота гребешка" @onfocus="@(() => _active = "height")"
                          InputMode="@(InputMode.@decimal)" Adornment="Adornment.End" AdornmentText="мкм" Immediate="true" Margin="Margin.Dense" />
        </MudField>
    </MudItem>
    <MudItem xs="12" sm="6">
        <ScallopSketch Active="@_active" />
    </MudItem>
    <MudItem xs="12">
        <CalcNote>
            На малой глубине сфера режет диаметром Dэф = 2·√(ap·(D − ap)), а не полным — обороты считаются по нему. Расчёт для фрезы, стоящей перпендикулярно поверхности.
        </CalcNote>
        <CalcNote>
            Гребешок: вводится шаг или высота — второе считается, h = R − √(R² − шаг²/4). Для плоской поверхности; на наклонной стенке гребешок при том же шаге по высоте больше.
        </CalcNote>
    </MudItem>
    }
</MudGrid>

@code
{
    /// <summary> Какие карточки показать: chip-thinning, high-feed или ball (сферическая фреза). </summary>
    [Parameter] public string Part { get; set; } = "chip-thinning";

    /// <summary> Размер на эскизе, соответствующий полю в фокусе. </summary>
    string? _active;

    string ThinningResult
    {
        get
        {
            var diameter = Util.GetDouble(State.ThinningDiameter);
            var width = Util.GetDouble(State.ThinningWidth);
            var factor = MillingMath.ChipThinningFactor(diameter, width);
            if (double.IsNaN(factor)) return width > diameter && diameter > 0 ? "Ширина резания больше диаметра фрезы" : "—";
            if (factor >= 1) return "Утонения нет: ширина от половины диаметра";
            var feed = Util.GetDouble(State.ThinningFeed);
            var result = $"Толщина стружки: {Text(factor * 100, 0)}% подачи";
            return feed > 0 ? $"{result}; подачу можно поднять до {Text(MillingMath.FeedForChipThickness(diameter, width, feed), 3)} мм/зуб" : result;
        }
    }

    string HighFeedResult
    {
        get
        {
            var diameter = Util.GetDouble(State.HighFeedDiameter);
            var width = Util.GetDouble(State.HighFeedWidth);
            var fz = Util.GetDouble(State.HighFeedFz);
            var hex = MillingMath.HighFeedChipThickness(diameter, width, Util.GetDouble(State.HighFeedAngle), fz);
            if (double.IsNaN(hex)) return width > diameter && diameter > 0 ? "Ширина резания больше диаметра фрезы" : "—";
            var corrected = MillingMath.HighFeedCorrectedFeed(diameter, width, fz);
            var lines = new List<string> { $"Толщина стружки: {Text(hex, 3)} мм", $"fz с учётом ae: {Text(corrected, 3)} мм/зуб" };
            var teeth = Util.GetDouble(State.HighFeedTeeth);
            var speed = Util.GetDouble(State.HighFeedSpeed);
            if (teeth > 0 && speed > 0) lines.Add($"Подача: {Text(corrected * teeth * speed, 0)} мм/мин");
            return string.Join("\n", lines);
        }
    }

    string BallResult
    {
        get
        {
            var effective = MillingMath.BallEffectiveDiameter(Util.GetDouble(State.BallDiameter), Util.GetDouble(State.BallDepth));
            if (double.IsNaN(effective)) return "—";
            var speed = MillingMath.SpindleSpeed(Util.GetDouble(State.BallSpeed), effective);
            var result = $"Dэф = {Text(effective, 2)} мм";
            return double.IsNaN(speed) ? result : $"{result}; обороты {Text(speed, 0)} об/мин";
        }
    }

    string ScallopDiameter
    {
        get => State.ScallopDiameter;
        set
        {
            State.ScallopDiameter = value;
            RecalculateScallop();
        }
    }

    void SetScallop(bool fromHeight, string value)
    {
        State.ScallopFromHeight = fromHeight;
        if (fromHeight) State.ScallopHeight = value;
        else State.ScallopStep = value;
        RecalculateScallop();
    }

    void RecalculateScallop()
    {
        var diameter = Util.GetDouble(State.ScallopDiameter);
        if (State.ScallopFromHeight)
            State.ScallopStep = Field(MillingMath.StepForScallop(diameter, Util.GetDouble(State.ScallopHeight) / 1000), 3);
        else
            State.ScallopHeight = Field(MillingMath.ScallopHeight(diameter, Util.GetDouble(State.ScallopStep)) * 1000, 1);
    }

    static string Text(double value, int digits) => Math.Round(value, digits).ToString(CultureInfo.InvariantCulture);

    static string Field(double value, int digits) => double.IsNaN(value) || value <= 0 ? string.Empty : Text(value, digits);
}
