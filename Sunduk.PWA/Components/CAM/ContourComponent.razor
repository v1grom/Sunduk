@using Sunduk.PWA.Infrastructure.Visualization
@inject ISnackbar Snackbar

<style>
    /* Строки контура: колонки одинаковой ширины в каждой строке, независимо от типа элемента */
    .cnt-row { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 4px 8px; padding: 4px 8px 6px 4px; border-bottom: 1px solid var(--mud-palette-lines-default); }
    .cnt-row:last-child { border-bottom: none; }
    .cnt-flag { flex: 0 0 22px; display: flex; align-items: center; justify-content: center; height: 40px; }
    .cnt-type { flex: 0 0 116px; }
    .cnt-dir { flex: 0 0 36px; display: flex; align-items: center; justify-content: center; height: 40px; }
    .cnt-f { flex: 1 1 62px; min-width: 62px; }
    .cnt-act { flex: 0 0 auto; display: flex; align-items: center; height: 40px; margin-left: auto; }
    .cnt-act .mud-icon-button { padding: 6px; }
    .cnt-head { display: flex; gap: 8px; padding: 0 8px 0 4px; font-size: 0.7rem; opacity: 0.65; }
</style>

<MudField Label="Контур" Variant="Variant.Filled" Margin="Margin.Dense" Underline="false">
    <MudGrid Spacing="1">
        <MudItem xs="12" lg="6">
            @{ var elements = Contour ?? new List<Element>(); }
            @for (var index = 0; index < elements.Count; index++)
            {
                var element = elements[index];
                var i = index;
                <div class="cnt-row">
                    <div class="cnt-flag">
                        @{ var problem = Problem(i); }
                        @if (problem is not null)
                        {
                            <MudTooltip Text="@problem">
                                <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Color="Color.Error" Size="Size.Small" />
                            </MudTooltip>
                        }
                    </div>
                    @switch (element)
                    {
                        case Point point:
                            <div class="cnt-type">
                                <MudSelect T="ElementType" Value="ElementType.Point" Variant="Variant.Text" ReadOnly="true" OpenIcon="@null" Label="Тип" Margin="Margin.Dense">
                                    <MudSelectItem T="ElementType" Value="ElementType.Point">Старт</MudSelectItem>
                                </MudSelect>
                            </div>
                            <div class="cnt-dir"></div>
                            <div class="cnt-f">
                                <MudTextField @bind-Value="point.X" @bind-Value:after="Notify" Variant="Variant.Text" Immediate="true" Label="X" Margin="Margin.Dense" Converter="Util.NullableDoubleConverterWithZero" />
                            </div>
                            <div class="cnt-f">
                                <MudTextField @bind-Value="point.Z" @bind-Value:after="Notify" Variant="Variant.Text" Immediate="true" Label="Z" Margin="Margin.Dense" Converter="Util.NullableDoubleConverterWithZero" />
                            </div>
                            <div class="cnt-f"></div>
                            <div class="cnt-f">
                                <MudTextField @bind-Value="point.Blunt" @bind-Value:after="Notify" Variant="Variant.Text" Immediate="true" Label="R" Margin="Margin.Dense" Converter="Util.DoubleConverter" />
                            </div>
                            break;
                        case Line line:
                            <div class="cnt-type">
                                <MudSelect T="ElementType" Value="ElementType.Line" Variant="Variant.Text" Immediate="true" ValueChanged="(type => SetArc(i, type))" Label="Тип" Margin="Margin.Dense">
                                    <MudSelectItem T="ElementType" Value="ElementType.Line">Линия</MudSelectItem>
                                    <MudSelectItem T="ElementType" Value="ElementType.Arc">Дуга</MudSelectItem>
                                </MudSelect>
                            </div>
                            <div class="cnt-dir"></div>
                            <div class="cnt-f">
                                <MudTextField @bind-Value="line.X" @bind-Value:after="Notify" Variant="Variant.Text" Immediate="true" Label="X" Margin="Margin.Dense" Converter="Util.NullableDoubleConverterWithZero" />
                            </div>
                            <div class="cnt-f">
                                <MudTextField @bind-Value="line.Z" @bind-Value:after="Notify" Variant="Variant.Text" Immediate="true" Label="Z" Margin="Margin.Dense" Converter="Util.NullableDoubleConverterWithZero" />
                            </div>
                            <div class="cnt-f">
                                <MudTextField @bind-Value="line.Angle" @bind-Value:after="Notify" Variant="Variant.Text" Immediate="true" Label="A°" Margin="Margin.Dense" Converter="Util.DoubleConverter" />
                            </div>
                            <div class="cnt-f">
                                <MudTextField @bind-Value="line.Blunt" @bind-Value:after="Notify" Variant="Variant.Text" Immediate="true" Label="@BluntLabel(line)" Margin="Margin.Dense" Converter="Util.DoubleConverter"
                                              Adornment="Adornment.End" AdornmentIcon="@(line.BluntType is Blunt.SimpleChamfer ? Icons.Material.Filled.ChangeHistory : Icons.Material.Filled.RoundedCorner)"
                                              AdornmentAriaLabel="Переключить скругление / фаску" OnAdornmentClick="(() => ToggleBluntType(line))" />
                            </div>
                            break;
                        case Arc arc:
                            <div class="cnt-type">
                                <MudSelect T="ElementType" Value="ElementType.Arc" Variant="Variant.Text" Immediate="true" ValueChanged="(type => SetLine(i, type))" Label="Тип" Margin="Margin.Dense">
                                    <MudSelectItem T="ElementType" Value="ElementType.Line">Линия</MudSelectItem>
                                    <MudSelectItem T="ElementType" Value="ElementType.Arc">Дуга</MudSelectItem>
                                </MudSelect>
                            </div>
                            <div class="cnt-dir">
                                <MudTooltip Text="@(arc.Direction is Sunduk.Geometry.Direction.CW ? "По часовой стрелке (G2)" : "Против часовой стрелки (G3)")">
                                    <MudIconButton Icon="@(arc.Direction is Sunduk.Geometry.Direction.CW ? Icons.Material.Filled.RotateRight : Icons.Material.Filled.RotateLeft)"
                                                   Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary" OnClick="(() => ToggleArcDirection(arc))" aria-label="Направление дуги" />
                                </MudTooltip>
                            </div>
                            <div class="cnt-f">
                                <MudTextField @bind-Value="arc.X" @bind-Value:after="Notify" Variant="Variant.Text" Immediate="true" Label="X" Margin="Margin.Dense" Converter="Util.NullableDoubleConverterWithZero" />
                            </div>
                            <div class="cnt-f">
                                <MudTextField @bind-Value="arc.Z" @bind-Value:after="Notify" Variant="Variant.Text" Immediate="true" Label="Z" Margin="Margin.Dense" Converter="Util.NullableDoubleConverterWithZero" />
                            </div>
                            <div class="cnt-f"></div>
                            <div class="cnt-f">
                                <MudTextField @bind-Value="arc.Radius" @bind-Value:after="Notify" Variant="Variant.Text" Immediate="true" Label="R дуги" Margin="Margin.Dense" Converter="Util.DoubleConverter" />
                            </div>
                            break;
                    }
                    <div class="cnt-act">
                        <MudTooltip Text="Рассчитать пустые поля">
                            <MudIconButton Icon="@Icons.Material.Filled.Calculate" Size="Size.Small" OnClick="(() => CalculateElement(i))" aria-label="Рассчитать пустые поля" />
                        </MudTooltip>
                        <MudTooltip Text="Добавить элемент после этого">
                            <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" OnClick="(() => InsertAfter(i))" aria-label="Добавить элемент после" />
                        </MudTooltip>
                        <MudTooltip Text="@(i > 0 ? "Удалить элемент" : "Первый узел удалить нельзя")">
                            <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small" Disabled="@(i == 0)" OnClick="(() => RemoveAt(i))" aria-label="Удалить элемент" />
                        </MudTooltip>
                    </div>
                </div>
            }
        </MudItem>
        <MudItem xs="12" lg="6">
            @{ var scene = BuildScene(); }
            <MudPaper Outlined="true" Class="mt-1">
                @if (scene.Valid)
                {
                    var path = scene.Toolpath;
                    <svg viewBox="0 0 @TurningScene.F(TurningScene.Width) @TurningScene.F(scene.Height)" width="100%" style="display: block;"
                         xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet">
                        @if (scene.HasStock)
                        {
                            <path d="@scene.StockFillPath" fill="var(--mud-palette-text-secondary)" fill-opacity="0.18" fill-rule="evenodd" stroke="none" />
                            <path d="@scene.StockOutlinePath" fill="none" stroke="var(--mud-palette-text-secondary)" stroke-width="1" />
                            <path d="@scene.HoleOutlinePath" fill="none" stroke="var(--mud-palette-text-secondary)" stroke-width="1" />
                        }
                        @* ось вращения и торец Z0 *@
                        @if (scene.AxisVisible)
                        {
                            <path d="M 0,@TurningScene.F(scene.Y(0)) L @TurningScene.F(TurningScene.Width),@TurningScene.F(scene.Y(0))" stroke="var(--mud-palette-text-secondary)" stroke-width="1" stroke-dasharray="8,3,2,3" fill="none" />
                        }
                        <path d="M @TurningScene.F(scene.X(0)),0 L @TurningScene.F(scene.X(0)),@TurningScene.F(scene.Height)" stroke="var(--mud-palette-text-secondary)" stroke-width="1" stroke-dasharray="2,3" fill="none" />
                        <text x="@TurningScene.F(scene.X(0) + 3)" y="11" font-size="10" fill="var(--mud-palette-text-secondary)">Z0</text>
                        @if (path is not null)
                        {
                            @* номинальный контур детали *@
                            <path d="@scene.PathD(path.Nominal)" fill="none" stroke="var(--mud-palette-primary)" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round" />
                        }
                        @* система координат — всегда в левом верхнем углу, поверх остального *@
                        <g stroke="var(--mud-palette-text-primary)" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M 14,46 L 48,46 M 42,41 L 48,46 L 42,51" />
                            <path d="M 14,46 L 14,12 M 9,18 L 14,12 L 19,18" />
                        </g>
                        <text x="52" y="50" font-size="12" font-weight="bold" fill="var(--mud-palette-text-primary)">Z+</text>
                        <text x="20" y="16" font-size="12" font-weight="bold" fill="var(--mud-palette-text-primary)">X+</text>
                        @* подписи R/C на узлах; серые/красные — угол не скруглён, G-код R/C там не пишет *@
                        @if (path is not null)
                        {
                            @foreach (var mark in path.Corners)
                            {
                                @((MarkupString)CornerMarkup(scene, mark))
                            }
                        }
                    </svg>
                }
                else
                {
                    <MudText Class="pa-4" Typo="Typo.body2" Color="Color.Secondary">Задайте как минимум две точки контура</MudText>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudField>


@code {
    public Variant FieldsVariant => Variant.Filled;
    public Variant ButtonsVariant => Variant.Filled;
    public bool FieldsUnderline => false;
    public bool FirstFieldsUnderline => false;
    public int ButtonSize => 48;
    public int FieldsWidth => 87;

    [Parameter]
    public List<Element> Contour { get; set; } = new List<Element>
    {
        new Point(null, null)
    };

    [Parameter]
    public EventCallback<List<Element>> ContourChanged { get; set; }

    /// <summary>Состояние заготовки перед этим переходом (после всех предыдущих), null — не показывать.</summary>
    [Parameter]
    public StockProfile? Stock { get; set; }

    [Parameter]
    public double StockLength { get; set; }

    /// <summary>Наружная обработка (по умолчанию). У внутренней (расточка) мнимый торец перед первым
    /// узлом идёт вверх от узла, а не от оси.</summary>
    [Parameter]
    public bool External { get; set; } = true;

    [Parameter]
    public double FacingAllowance { get; set; }

    /// <summary>Подпись R/C у узла. Собирается как разметка (элемент text в Razor-блоке кода
    /// трактуется как служебный тег); все подставляемые значения — числа или экранированный текст.</summary>
    static string CornerMarkup(TurningScene scene, CornerMark mark)
    {
        var color = mark.Applied ? "var(--mud-palette-primary)" : "var(--mud-palette-error)";
        var x = scene.X(mark.Node.Z);
        var y = scene.Y(mark.Node.R);
        var hint = System.Net.WebUtility.HtmlEncode(mark.Reason ?? "Скругление/фаска применены");
        var label = System.Net.WebUtility.HtmlEncode(mark.Label + (mark.Applied ? string.Empty : " ✕"));
        return $"<circle cx=\"{TurningScene.F(x)}\" cy=\"{TurningScene.F(y)}\" r=\"2.5\" fill=\"none\" stroke=\"{color}\" stroke-width=\"1\"/>" +
               $"<text x=\"{TurningScene.F(x + 6)}\" y=\"{TurningScene.F(y - 6)}\" font-size=\"11\" fill=\"{color}\"><title>{hint}</title>{label}</text>";
    }

    TurningScene BuildScene()
        => new(TurningToolpath.Build(Contour, External), Stock, StockLength, FacingAllowance);

    public ElementType Type { get; set; }

    public enum ElementType
    {
        Point,
        Line,
        Arc
    }

    static (double? x, double? z) Resolve(double? x, double? z, Element prev)
    {
        double? rx = x;
        double? rz = z;
        if (rx is null && prev is not null) rx = prev.X;
        if (rz is null && prev is not null) rz = prev.Z;
        return (rx, rz);
    }

    void Notify() => ContourChanged.InvokeAsync(Contour);

    private void SetArc(int index, ElementType type)
    {
        if (type is not ElementType.Arc) return;
        if (Contour[index] is Line line)
        {
            Contour[index] = new Arc(line.X, line.Z, line.Blunt > 0 ? line.Blunt : 1, Sunduk.Geometry.Direction.CCW);
            Notify();
        }
    }

    private void SetLine(int index, ElementType type)
    {
        if (type is not ElementType.Line) return;
        if (Contour[index] is Arc arc)
        {
            Contour[index] = new Line(arc.X, arc.Z, 0, arc.Radius);
            Notify();
        }
    }

    private void ToggleArcDirection(Arc arc)
    {
        arc.Direction = arc.Direction is Sunduk.Geometry.Direction.CW ? Sunduk.Geometry.Direction.CCW : Sunduk.Geometry.Direction.CW;
        Notify();
    }

    private void InsertAfter(int index)
    {
        Contour.Insert(index + 1, new Line(null, null));
        Notify();
    }

    private void RemoveAt(int index)
    {
        if (index <= 0) return;
        Contour.RemoveAt(index);
        Notify();
    }

    string ContourElementIcon(Element element)
    {
        return element switch
        {
            Line => Icons.Material.Filled.ArrowDropDown,
            Arc arc => arc.Direction is Sunduk.Geometry.Direction.CW ? Icons.Material.Filled.RotateRight : Icons.Material.Filled.RotateLeft,
            _ => Icons.Material.Filled.ArrowDropDown
            };
    }

    static string BluntLabel(Line line)
    {
        return line.BluntType switch
        {
            Blunt.Radius => "R",
            Blunt.SimpleChamfer => "C",
            _ => string.Empty,
        };
    }

    /// <summary>Что не так с элементом контура (null — всё в порядке). Показывается значком в начале строки.</summary>
    string? Problem(int index)
    {
        if (Contour is null || index < 0 || index >= Contour.Count) return null;
        var element = Contour[index];
        if (index == 0)
            return element.X is null || element.Z is null ? "Задайте X и Z стартовой точки" : null;

        var prev = Contour[index - 1];
        switch (element)
        {
            case Line line:
                if (line.X is not null && line.Z is not null) return null;
                if (line.Angle != 0 && (line.X is not null || line.Z is not null)) return null;
                if ((line.X is not null || prev.X is not null) && (line.Z is not null || prev.Z is not null)) return null;
                if (index + 1 < Contour.Count)
                {
                    var next = Contour[index + 1];
                    if ((line.X is not null || next.X is not null) && (line.Z is not null || next.Z is not null)) return null;
                }
                return "Не хватает координат: задайте X и Z (или одну координату и угол)";
            case Arc arc:
                if (arc.Radius <= 0) return "Радиус дуги должен быть больше нуля";
                var (x, z) = Resolve(arc.X, arc.Z, prev);
                var (px, pz) = Resolve(prev.X, prev.Z, null);
                if (x is null || z is null || px is null || pz is null) return "Не заданы координаты конца дуги";
                var dx = (x.Value - px.Value) / 2;
                var dz = z.Value - pz.Value;
                var chord = Math.Sqrt(dx * dx + dz * dz);
                if (arc.Radius * 2 < chord - 1e-6)
                    return $"Радиус мал: хорда {chord.ToPrettyString(3, Util.PrettyStringOption.AsIs)}, нужен R не меньше {(chord / 2).ToPrettyString(3, Util.PrettyStringOption.AsIs)}. В G-коде дуга станет прямой";
                return null;
            default:
                return null;
        }
    }

    private void ToggleBluntType(Line line)
    {
        line.BluntType = line.BluntType is Blunt.SimpleChamfer ? Blunt.Radius : Blunt.SimpleChamfer;
        Notify();
    }

    void CalculateElement(int index)
    {
        var message = ContourCalculator.Calculate(Contour, index);
        if (message is not null) Snackbar.Add(message, Severity.Warning);
        Notify();
    }
}